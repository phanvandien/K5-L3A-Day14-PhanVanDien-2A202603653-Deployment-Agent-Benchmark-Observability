# Copy thành .env rồi điền giá trị thật:  cp .env.example .env
# (.env đã nằm trong .gitignore — KHÔNG commit)

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret — đặt giá trị thật trong .env hoặc biến môi trường trên platform
AGENT_API_KEY=change-me

# Docker Compose ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
